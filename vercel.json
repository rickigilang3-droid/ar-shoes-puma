{
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/shoe/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/compare/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/ar/:path*",
      "destination": "/index.html"
    }
  ]
}
